# nginx reverse proxy for Quorum.
server {
    listen 80;
    server_name quorum.example.org;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name quorum.example.org;

    ssl_certificate     /etc/letsencrypt/live/quorum.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/quorum.example.org/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        # Single trusted value from the socket; the app keys rate limits on it
        # when QUORUM_TRUST_PROXY_HEADERS=true. Do not pass inbound XFF through.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_read_timeout 35s;
        client_max_body_size 2m;   # app enforces 1 MiB itself
    }
}
