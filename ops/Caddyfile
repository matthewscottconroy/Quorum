# Caddy reverse proxy for Quorum: automatic Let's Encrypt TLS in five lines.
# Caddy ships as a single static binary (works on any distro, including
# Amazon Linux 2023 where certbot is not packaged):
#   https://caddyserver.com/download  → /usr/local/bin/caddy + its systemd unit
# Replace quorum.example.org with your domain (DNS must already point here).

quorum.example.org {
	# The app must listen on localhost only (QUORUM_PORT=8080, firewalled).
	reverse_proxy 127.0.0.1:8080 {
		# The app rate-limits by X-Real-IP when QUORUM_TRUST_PROXY_HEADERS=true.
		header_up X-Real-IP {client_ip}
	}
	encode gzip
}

# One server can carry any number of additional sites — Caddy issues and
# renews a certificate per site block. Common pattern: the org's public
# website (static files) beside the internal Quorum app, different domains.
# Uncomment and adjust:
#
# company.example.com, www.company.example.com {
# 	root * /srv/company-site
# 	file_server
# 	encode gzip
# }
#
# Notes: `sudo mkdir -p /srv/company-site` and put index.html there; keep the
# site's source in its own git repository (it is NOT covered by Quorum's
# database backups); `sudo systemctl reload caddy` applies changes with zero
# downtime. Quorum's domain and the public site's domain are independent —
# only QUORUM_BASE_URL must match the domain that serves the app.
