# Copy this file to .env and fill in the values.

QUORUM_PORT=8080
# sslmode=disable is for local development only.
# Production MUST use sslmode=require (or stronger, e.g. verify-full).
QUORUM_DATABASE_URL=postgres://quorum:REPLACE_WITH_DB_PASSWORD@localhost:5432/quorum?sslmode=disable
QUORUM_JWT_SECRET=replace-with-64-random-hex-chars
QUORUM_JWT_ACCESS_TTL=15m
QUORUM_JWT_REFRESH_TTL=168h
QUORUM_BASE_URL=http://localhost:8080

# Set to true ONLY when running behind a reverse proxy/ingress that sets
# X-Real-IP or X-Forwarded-For and strips client-supplied forwarding headers.
# When true, login/refresh rate limiting keys on the forwarded client IP so
# users behind the proxy don't share a single bucket. Leave unset for direct
# exposure — otherwise clients could spoof their rate-limit key.
# QUORUM_TRUST_PROXY_HEADERS=true

# Optional: observability.
# Structured-log level: debug | info | warn | error (default info). Logs are
# emitted as JSON to stdout, one object per request with a request_id.
# QUORUM_LOG_LEVEL=info
# Prometheus /metrics is DISABLED unless a token is set. When set, scrapers must
# present it as `Authorization: Bearer <token>` or `?token=<token>`. Keep the
# endpoint firewalled to your monitoring network regardless.
# QUORUM_METRICS_TOKEN=

# Optional: SMTP for email reminders
QUORUM_SMTP_HOST=smtp.example.com
QUORUM_SMTP_PORT=587
QUORUM_SMTP_USER=
QUORUM_SMTP_PASS=
QUORUM_EMAIL_FROM=quorum@example.org
# When true, require an encrypted SMTP session (STARTTLS): sending fails rather
# than falling back to plaintext if the relay does not offer TLS. Default false.
# QUORUM_SMTP_REQUIRE_TLS=true

# Optional: payment provider webhook secrets.
# When a secret is unset, that provider's webhook endpoint returns 503 (fail closed).
QUORUM_STRIPE_WEBHOOK_SECRET=whsec_...
QUORUM_PAYPAL_WEBHOOK_ID=
# Local development only: process webhooks WITHOUT signature verification when
# the secret above is unset (e.g. Stripe CLI testing). Never set in production.
# QUORUM_ALLOW_UNSIGNED_WEBHOOKS=true

# Used by docker-compose for the postgres container.
# Do not use a guessable password — generate one: openssl rand -hex 16
# (must match the password in QUORUM_DATABASE_URL above)
DB_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD
