# Copy this file to .env and fill in the values.

QUORUM_PORT=8080
QUORUM_DATABASE_URL=postgres://quorum:changeme@localhost:5432/quorum?sslmode=disable
QUORUM_JWT_SECRET=replace-with-64-random-hex-chars
QUORUM_JWT_ACCESS_TTL=15m
QUORUM_JWT_REFRESH_TTL=168h
QUORUM_BASE_URL=http://localhost:8080

# Optional: SMTP for email reminders
QUORUM_SMTP_HOST=smtp.example.com
QUORUM_SMTP_PORT=587
QUORUM_SMTP_USER=
QUORUM_SMTP_PASS=
QUORUM_EMAIL_FROM=quorum@example.org

# Optional: payment provider webhook secrets
QUORUM_STRIPE_WEBHOOK_SECRET=whsec_...
QUORUM_PAYPAL_WEBHOOK_ID=

# Used by docker-compose for the postgres container
DB_PASSWORD=changeme
